# Clean addresses on Apache hosts (Hostinger and similar); Vercel uses vercel.json instead.
#   /rings.html → /rings (redirect), /rings → rings.html, /product/aurelia-band → product.html
Options -MultiViews
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteRule ^product/[^/]+/?$ product.html [L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]
